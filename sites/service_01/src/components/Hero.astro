---
/**
 * service_01 hero - "Shade".
 * A CSS/SVG composition (no photography): a light source seen through three
 * layered window silhouettes, each dimming it further. Layers drift at
 * different parallax speeds and a highlight sweeps across once on load.
 */
import Icon from '@autoservice/shared/components/Icon.astro';
import RatingBadge from '@autoservice/shared/components/RatingBadge.astro';
import { site } from '../site';

const cheapest = site.prices.reduce((low, row) => (row.min < low.min ? row : low));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__scene" aria-hidden="true">
    <div class="hero__sun" data-parallax="-0.06"></div>
    <div class="hero__pane hero__pane--back" data-parallax="0.05"><i></i></div>
    <div class="hero__pane hero__pane--mid" data-parallax="0.11"><i></i></div>
    <div class="hero__pane hero__pane--front" data-parallax="0.18"><i></i></div>
    <div class="hero__horizon"></div>
  </div>
  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow" data-reveal="fade">
      {site.content.categoryRu}
      <span class="hero__dot"></span>
      {site.content.addressRu.city}
    </p>
    <h1 id="hero-title" class="hero__title" data-split>Тонировка автомобильных стёкол</h1>
    <p class="lead hero__lead" data-reveal="up" style="--reveal-delay: 350ms">
      Лобовое, заднее, боковые стёкла и форточки. Цены — {cheapest.display}.
    </p>
    <div class="cluster hero__actions" data-reveal="up" style="--reveal-delay: 480ms">
      <a class="btn btn--primary" href="#request">
        Оставить заявку
        <Icon name="arrow" />
      </a>
      <a class="btn" href="#prices">Смотреть цены</a>
    </div>
    <div class="hero__meta" data-reveal="up" style="--reveal-delay: 620ms">
      <RatingBadge site={site} />
      <p class="hero__address">
        <Icon name="pin" />
        {site.addressLine}
      </p>
    </div>
  </div>
  <a class="hero__scroll" href="#prices" aria-label="К услугам и ценам">
    <span></span>
  </a>
</section>
