---
import type { ImageMetadata } from 'astro';
import BaseLayout from '@autoservice/shared/layouts/BaseLayout.astro';
import SiteHeader from '@autoservice/shared/components/SiteHeader.astro';
import SiteFooter from '@autoservice/shared/components/SiteFooter.astro';
import SectionHead from '@autoservice/shared/components/SectionHead.astro';
import PriceList from '@autoservice/shared/components/PriceList.astro';
import ContactPanel from '@autoservice/shared/components/ContactPanel.astro';
import LeadForm from '@autoservice/shared/components/LeadForm.astro';
import Gallery from '@autoservice/shared/components/Gallery.astro';
import Icon from '@autoservice/shared/components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import Hero from '../components/Hero.astro';
import '../styles/theme.css';
import { ratingCountLabel } from '@autoservice/shared/lib/model';
import { site, nav, THEME_COLOR } from '../site';

// Approved first-party photos only (see shared/components/Gallery.astro).
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../../../../services/service_01/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const a = site.content.addressRu;
---

<BaseLayout site={site} title="тонировка автомобильных стёкол в Комсомольске-на-Амуре" themeColor={THEME_COLOR}>
  <link slot="head" rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <SiteHeader slot="header" site={site} nav={nav}>
    <BrandMark slot="mark" />
  </SiteHeader>

  <Hero />

  <section class="section" id="prices" aria-labelledby="prices-title">
    <div class="container">
      <SectionHead
        id="prices-title"
        index="01"
        eyebrow="Услуги и цены"
        title="Три позиции — одно направление"
        lead="В опубликованном прайсе сервиса — тонировка автомобильных стёкол. Стоимость зависит от элемента остекления."
      />
      <div class="shade-prices">
        <PriceList site={site} variant="cards" />
      </div>
    </div>
  </section>

  <section class="section section--alt about" id="about" aria-labelledby="about-title">
    <p class="about__ghost" aria-hidden="true" data-parallax="0.08">Detail</p>
    <div class="container split" style="--split: 1.25fr 1fr">
      <div>
        <SectionHead id="about-title" index="02" eyebrow="О сервисе" title={`${site.name} — автодетейлинг в Центральном округе`} />
        <p class="about__text" data-reveal="up">
          Сервис находится в Комсомольске-на-Амуре по адресу {a.street}. Здесь занимаются
          тонировкой автомобильных стёкол: лобового, заднего, боковых и форточек.
        </p>
      </div>
      <dl class="facts" data-stagger>
        <div class="facts__row" data-reveal="left">
          <dt>Направление</dt>
          <dd>{site.services[0]}</dd>
        </div>
        <div class="facts__row" data-reveal="left">
          <dt>Город</dt>
          <dd>{a.city}</dd>
        </div>
        {
          site.rating && (
            <div class="facts__row" data-reveal="left">
              <dt>Рейтинг в 2ГИС</dt>
              <dd>
                {site.rating.value} · {ratingCountLabel(site.rating)}
              </dd>
            </div>
          )
        }
        <div class="facts__row" data-reveal="left">
          <dt>Связь</dt>
          <dd>{site.messengers.join(', ')}</dd>
        </div>
      </dl>
    </div>
  </section>

  {
    site.photos.length > 0 && (
      <section class="section" id="gallery" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHead id="gallery-title" eyebrow="Фото" title="Фотографии сервиса" />
          <Gallery photos={site.photos} files={photoFiles} />
        </div>
      </section>
    )
  }

  <section class="section" id="contacts" aria-labelledby="contacts-title">
    <div class="container split" style="--split: 1fr 1.1fr">
      <div class="location" data-reveal="scale">
        <div class="location__panes" aria-hidden="true"><i></i><i></i><i></i></div>
        <p class="eyebrow"><Icon name="pin" /> Как найти</p>
        <p class="location__street">{a.street}</p>
        <p class="muted">{a.district}, {a.city}</p>
        <a class="text-link" href={site.links.profile} target="_blank" rel="noopener noreferrer">
          Посмотреть на карте 2ГИС
          <Icon name="external" />
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>
      </div>
      <div>
        <SectionHead id="contacts-title" index="03" eyebrow="Контакты" title="Адрес и связь" />
        <ContactPanel site={site} />
      </div>
    </div>
  </section>

  <section class="section section--alt request" id="request" aria-labelledby="request-title">
    <div class="container split" style="--split: 1fr 1.15fr">
      <div class="request__intro">
        <SectionHead
          id="request-title"
          index="04"
          eyebrow="Заявка"
          title="Запишитесь на тонировку"
          lead="Укажите автомобиль и стёкла, которые нужно затонировать. Точную стоимость и время назовёт сервис."
        />
      </div>
      <div data-reveal="up">
        <LeadForm site={site} options={site.prices.map((row) => row.labelRu)} />
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" site={site} nav={nav} />
</BaseLayout>
