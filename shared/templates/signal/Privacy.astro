---
import PrivacyPage from '../PrivacyPage.astro';
import Mark from './Mark.astro';
import './theme.css';
import type { TemplateProps } from '../types';

type Props = TemplateProps;
const props = Astro.props;
---

<PrivacyPage {...props}>
  <link slot="head" rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <Mark slot="mark" />
</PrivacyPage>
