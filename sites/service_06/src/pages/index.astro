---
import type { ImageMetadata } from 'astro';
import BaseLayout from '@autoservice/shared/layouts/BaseLayout.astro';
import SiteHeader from '@autoservice/shared/components/SiteHeader.astro';
import SiteFooter from '@autoservice/shared/components/SiteFooter.astro';
import SectionHead from '@autoservice/shared/components/SectionHead.astro';
import PriceList from '@autoservice/shared/components/PriceList.astro';
import ServiceList from '@autoservice/shared/components/ServiceList.astro';
import ContactPanel from '@autoservice/shared/components/ContactPanel.astro';
import LeadForm from '@autoservice/shared/components/LeadForm.astro';
import Gallery from '@autoservice/shared/components/Gallery.astro';
import CtaBand from '@autoservice/shared/components/CtaBand.astro';
import Icon from '@autoservice/shared/components/Icon.astro';
import { ratingCountLabel } from '@autoservice/shared/lib/model';
import BrandMark from '../components/BrandMark.astro';
import Hero from '../components/Hero.astro';
import '../styles/theme.css';
import { site, nav, THEME_COLOR } from '../site';

// Approved first-party photos only (see shared/components/Gallery.astro).
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../../../../services/service_06/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const a = site.content.addressRu;
---

<BaseLayout site={site} title="диагностика автомобиля в Комсомольске-на-Амуре" themeColor={THEME_COLOR}>
  <link slot="head" rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <SiteHeader slot="header" site={site} nav={nav}>
    <BrandMark slot="mark" />
  </SiteHeader>

  <Hero />

  <section class="section menu" id="prices" aria-labelledby="prices-title">
    <div class="container">
      <SectionHead
        id="prices-title"
        index="/01"
        eyebrow="Цены"
        title="Меню диагностики"
        lead="Четыре позиции из прайса сервиса: от проверки подвески до полной компьютерной диагностики."
      />
      <PriceList site={site} variant="cards" />
    </div>
  </section>

  <div class="zig" aria-hidden="true"></div>

  <section class="section section--alt" id="services" aria-labelledby="services-title">
    <div class="container split" style="--split: 0.8fr 1.5fr">
      <SectionHead
        id="services-title"
        index="/02"
        eyebrow="Услуги"
        title="Что делает сервис"
        lead="Направления из карточки компании. Цены указаны только на диагностику — остальное уточняйте."
      />
      <ServiceList items={site.services} variant="rows" />
    </div>
  </section>

  <div class="zig zig--flip" aria-hidden="true"></div>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="container split" style="--split: 1.3fr 1fr">
      <div>
        <SectionHead id="about-title" index="/03" eyebrow="О сервисе" title={`${site.name} на Аллее Труда`} />
        <p class="about__text" data-reveal="up">
          {site.name} — автосервис в Центральном округе Комсомольска-на-Амуре. Адрес: {a.street}. В карточке
          сервиса — диагностика подвески, комплексная диагностика и компьютерная диагностика электронных
          систем.
        </p>
      </div>
      <dl class="readout" data-stagger>
        {
          site.rating && (
            <div class="readout__row" data-reveal="left">
              <dt>Рейтинг в 2ГИС</dt>
              <dd>
                <strong>{site.rating.value}</strong>
                <span>{ratingCountLabel(site.rating)}</span>
              </dd>
            </div>
          )
        }
        <div class="readout__row" data-reveal="left">
          <dt>Позиций в прайсе</dt>
          <dd>
            <strong>{site.prices.length}</strong>
            <span>диагностика</span>
          </dd>
        </div>
        <div class="readout__row" data-reveal="left">
          <dt>Мессенджер</dt>
          <dd>
            <strong>{site.messengers.join(', ')}</strong>
            <span>указан в карточке</span>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {
    site.photos.length > 0 && (
      <section class="section section--alt" id="gallery" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHead id="gallery-title" eyebrow="Фото" title="Фотографии сервиса" />
          <Gallery photos={site.photos} files={photoFiles} />
        </div>
      </section>
    )
  }

  <section class="section section--alt" id="contacts" aria-labelledby="contacts-title">
    <div class="container split" style="--split: 1.1fr 1fr">
      <div>
        <SectionHead id="contacts-title" index="/04" eyebrow="Контакты" title="Адрес и связь" />
        <ContactPanel site={site} />
      </div>
      <div class="plate" data-reveal="scale">
        <svg class="plate__zig" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M0 90 50 30l50 60 50-60 50 60 50-60 50 60 50-60 50 60"></path>
        </svg>
        <p class="eyebrow"><Icon name="pin" /> Как найти</p>
        <p class="plate__street">{a.street}</p>
        <p class="plate__area">{a.district}, {a.city}</p>
        <a class="text-link" href={site.links.profile} target="_blank" rel="noopener noreferrer">
          Посмотреть на карте 2ГИС
          <Icon name="external" />
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section request" id="request" aria-labelledby="request-title">
    <div class="container split" style="--split: 1fr 1.15fr">
      <div class="request__intro">
        <SectionHead
          id="request-title"
          index="/05"
          eyebrow="Заявка"
          title="Запишитесь на диагностику"
          lead="Укажите автомобиль и что беспокоит. Время визита и итоговую стоимость сообщит сервис."
        />
      </div>
      <div data-reveal="up">
        <LeadForm site={site} />
      </div>
    </div>
  </section>

  <CtaBand
    title="Нужна диагностика?"
    text="Контакты сервиса — в карточке компании в 2ГИС."
    href="#request"
    label="Оставить заявку"
  />

  <SiteFooter slot="footer" site={site} nav={nav} />
</BaseLayout>
