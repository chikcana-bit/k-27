---
/**
 * A dashed seam that "sews" itself: the dashed path is revealed through a
 * mask whose solid stroke is drawn with stroke-dashoffset. Must be placed
 * inside an <svg>. `id` has to be unique within the page.
 */
interface Props {
  id: string;
  d: string;
  color?: string;
  width?: number;
  dash?: string;
  transform?: string;
  /** Animation delay in ms. */
  delay?: number;
}
const { id, d, color = 'var(--thread-light)', width = 1.6, dash = '7 5', transform, delay = 700 } = Astro.props;
---

<mask id={id} maskUnits="userSpaceOnUse" x="-50" y="-50" width="1000" height="1000">
  <path
    class="sew"
    d={d}
    transform={transform}
    pathLength="1"
    fill="none"
    stroke="#fff"
    stroke-width={width + 5}
    style={`--sew-delay: ${delay}ms`}></path>
</mask>
<path
  d={d}
  transform={transform}
  mask={`url(#${id})`}
  fill="none"
  style={`stroke: ${color}`}
  stroke-width={width}
  stroke-dasharray={dash}
  stroke-linecap="round"></path>
