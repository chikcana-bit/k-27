---
/**
 * Contact details limited to the owner-provided record: address and phone(s).
 * Opening hours and e-mail appear only when the business's own website states
 * them (content.officialHoursRu / officialEmail); otherwise a neutral fallback.
 */
import type { SiteModel } from '../lib/types';
import Icon from './Icon.astro';
interface Props {
  site: SiteModel;
}
const { site } = Astro.props;
const { officialHoursRu, officialEmail } = site.content;
const primary = site.phones[0];
---

<div class="contact">
  <dl class="contact-list" data-stagger>
    <div class="contact-item" data-reveal="up">
      <span class="contact-item__icon"><Icon name="pin" /></span>
      <div>
        <dt class="contact-item__label">Адрес</dt>
        <dd class="contact-item__value">{site.street}</dd>
        <dd class="contact-item__hint">{site.city}, {site.region}</dd>
      </div>
    </div>
    <div class="contact-item" data-reveal="up">
      <span class="contact-item__icon"><Icon name="phone" /></span>
      <div>
        <dt class="contact-item__label">{site.phones.length > 1 ? 'Телефоны' : 'Телефон'}</dt>
        {
          site.phones.map((phone) => (
            <dd class="contact-item__value">
              <a class="text-link" href={`tel:${phone.href}`}>
                {phone.display}
              </a>
            </dd>
          ))
        }
      </div>
    </div>
    <div class="contact-item" data-reveal="up">
      <span class="contact-item__icon"><Icon name="clock" /></span>
      <div>
        <dt class="contact-item__label">Режим работы</dt>
        {
          officialHoursRu ? (
            <>
              <dd class="contact-item__value">{officialHoursRu}</dd>
              <dd class="contact-item__hint">По данным сайта компании. Перед визитом уточните.</dd>
            </>
          ) : (
            <>
              <dd class="contact-item__value">Уточняйте по телефону</dd>
              <dd class="contact-item__hint">График работы на сайте пока не указан.</dd>
            </>
          )
        }
      </div>
    </div>
    {
      officialEmail && (
        <div class="contact-item" data-reveal="up">
          <span class="contact-item__icon">
            <Icon name="mail" />
          </span>
          <div>
            <dt class="contact-item__label">Эл. почта</dt>
            <dd class="contact-item__value">
              <a class="text-link" href={`mailto:${officialEmail}`}>
                {officialEmail}
              </a>
            </dd>
            <dd class="contact-item__hint">Указана на сайте компании.</dd>
          </div>
        </div>
      )
    }
    {
      site.website && (
        <div class="contact-item" data-reveal="up">
          <span class="contact-item__icon">
            <Icon name="globe" />
          </span>
          <div>
            <dt class="contact-item__label">Сайт компании</dt>
            <dd class="contact-item__value">
              <a class="text-link" href={site.website} target="_blank" rel="noopener noreferrer">
                {new URL(site.website).hostname}
                <span class="sr-only">(откроется в новой вкладке)</span>
              </a>
            </dd>
          </div>
        </div>
      )
    }
  </dl>
  <div class="cluster contact-actions" data-reveal="up">
    {
      primary && (
        <a class="btn btn--primary" href={`tel:${primary.href}`}>
          <Icon name="phone" />
          Позвонить
        </a>
      )
    }
    <a class="btn" href={site.mapUrl} target="_blank" rel="noopener noreferrer">
      Адрес на карте
      <Icon name="external" />
      <span class="sr-only">(откроется в новой вкладке)</span>
    </a>
    <slot />
  </div>
</div>
