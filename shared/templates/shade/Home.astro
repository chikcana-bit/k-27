---
/** Shade home page: hero → services → about → contacts → request. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SectionHead from '../../components/SectionHead.astro';
import PriceNotice from '../../components/PriceNotice.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import LeadForm from '../../components/LeadForm.astro';
import Gallery from '../../components/Gallery.astro';
import Icon from '../../components/Icon.astro';
import Mark from './Mark.astro';
import Hero from './Hero.astro';
import './theme.css';
import type { TemplateProps } from '../types';

type Props = TemplateProps;
const { site, nav, themeColor, mirror, photoFiles = {} } = Astro.props;
const c = site.content;
const num = (index: number) => String(index + 1).padStart(2, '0');
const ghost = c.tags?.[0] ?? site.name.split(/[\s/]/)[0];
---

<BaseLayout site={site} title={c.pageTitle} themeColor={themeColor}>
  <link slot="head" rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <SiteHeader slot="header" site={site} nav={nav}>
    <Mark slot="mark" />
  </SiteHeader>

  <Hero site={site} mirror={mirror} />

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <SectionHead
        id="services-title"
        index="01"
        eyebrow="Услуги"
        title="Чем занимается сервис"
        lead="Направления работ по данным владельца."
      />
      <div class="shade-prices">
        <div class="prices prices--cards">
          <ul class="price-list" data-stagger>
            {
              site.services.map((item, index) => (
                <li class="price-row" data-reveal="up">
                  <span class="price-row__label">{item}</span>
                  <span class="price-row__value" aria-hidden="true">
                    {num(index)}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <PriceNotice site={site} />
    </div>
  </section>

  <section class="section section--alt about" id="about" aria-labelledby="about-title">
    <p class="about__ghost" aria-hidden="true" data-parallax="0.08">{ghost}</p>
    <div class="container split" style="--split: 1.25fr 1fr">
      <div>
        <SectionHead id="about-title" index="02" eyebrow="О сервисе" title={c.aboutTitle} />
        <p class="about__text" data-reveal="up">{c.aboutText}</p>
      </div>
      <dl class="facts" data-stagger>
        <div class="facts__row" data-reveal="left">
          <dt>Направление</dt>
          <dd>{c.categoryRu}</dd>
        </div>
        <div class="facts__row" data-reveal="left">
          <dt>Адрес</dt>
          <dd>{site.addressLine}</dd>
        </div>
        <div class="facts__row" data-reveal="left">
          <dt>Телефон</dt>
          <dd>
            {
              site.phones.map((phone) => (
                <a class="text-link facts__phone" href={`tel:${phone.href}`}>
                  {phone.display}
                </a>
              ))
            }
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {
    site.photos.length > 0 && (
      <section class="section" id="gallery" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHead id="gallery-title" eyebrow="Фото" title="Фотографии сервиса" />
          <Gallery photos={site.photos} files={photoFiles} />
        </div>
      </section>
    )
  }

  <section class="section" id="contacts" aria-labelledby="contacts-title">
    <div class="container split" style="--split: 1fr 1.1fr">
      <div class="location" data-reveal="scale">
        <div class="location__panes" aria-hidden="true"><i></i><i></i><i></i></div>
        <p class="eyebrow"><Icon name="pin" /> Как найти</p>
        <p class="location__street">{site.street}</p>
        <p class="muted">{site.city}, {site.region}</p>
        <a class="text-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">
          Открыть на карте
          <Icon name="external" />
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>
      </div>
      <div>
        <SectionHead id="contacts-title" index="03" eyebrow="Контакты" title="Адрес и связь" />
        <ContactPanel site={site} />
      </div>
    </div>
  </section>

  <section class="section section--alt request" id="request" aria-labelledby="request-title">
    <div class="container split" style="--split: 1fr 1.15fr">
      <div class="request__intro">
        <SectionHead id="request-title" index="04" eyebrow="Заявка" title={c.requestTitle} lead={c.requestLead} />
      </div>
      <div data-reveal="up">
        <LeadForm site={site} />
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" site={site} nav={nav} />
</BaseLayout>
