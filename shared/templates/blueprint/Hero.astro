---
/**
 * Blueprint hero (mechanical repair shops).
 * An abstract technical drawing in inline SVG (no photography): a gear-like
 * ring on centre lines linked to a wishbone-style linkage. Strokes draw
 * themselves on load, then the dimension lines extend. It is a diagram, not a
 * depiction of a real vehicle or of the workshop.
 */
import Icon from '../../components/Icon.astro';
import type { SiteModel } from '../../lib/types';
interface Props {
  site: SiteModel;
  mirror?: boolean;
}
const { site, mirror = false } = Astro.props;
const sheet = site.id.replace('service_', '');

const teeth = Array.from({ length: 24 }, (_, index) => {
  const angle = (index / 24) * Math.PI * 2;
  const point = (radius: number) =>
    `${(260 + Math.cos(angle) * radius).toFixed(1)} ${(250 + Math.sin(angle) * radius).toFixed(1)}`;
  return `M${point(150)}L${point(172)}`;
}).join('');
---

<section class:list={['hero', { 'hero--mirror': mirror }]} aria-labelledby="hero-title">
  <div class="hero__sheet" aria-hidden="true" data-parallax="-0.04"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow" data-reveal="fade">
        <span class="hero__ref">Лист {sheet}</span>
        {site.content.categoryRu} · {site.city}
      </p>
      <h1 id="hero-title" class="hero__title" data-split>{site.content.heroTitle}</h1>
      <p class="lead hero__lead" data-reveal="up" style="--reveal-delay: 350ms">{site.content.heroLead}</p>
      <div class="cluster" data-reveal="up" style="--reveal-delay: 480ms">
        <a class="btn btn--primary" href="#request">
          Оставить заявку
          <Icon name="arrow" />
        </a>
        <a class="btn" href="#services">Услуги</a>
      </div>
    </div>

    <div class="hero__drawing" aria-hidden="true">
      <svg class="draft draft--back" viewBox="0 0 640 520" focusable="false" data-parallax="0.05">
        <path class="draft__axis" d="M20 250H620M260 20V490M470 110V420" pathLength="1"></path>
        <circle class="draft__thin" cx="260" cy="250" r="200" pathLength="1"></circle>
      </svg>
      <svg class="draft draft--main" viewBox="0 0 640 520" focusable="false" data-parallax="0.1">
        <circle class="draft__line" cx="260" cy="250" r="150" pathLength="1" style="--d: 200ms"></circle>
        <path class="draft__line draft__teeth" d={teeth} pathLength="1" style="--d: 700ms"></path>
        <circle class="draft__line" cx="260" cy="250" r="92" pathLength="1" style="--d: 500ms"></circle>
        <circle class="draft__line draft__line--accent" cx="260" cy="250" r="34" pathLength="1" style="--d: 900ms"></circle>
        <path class="draft__line" d="M260 158V216M260 284V342M168 250H226M294 250H352" pathLength="1" style="--d: 1000ms"></path>
        <path class="draft__line" d="M410 250 470 150H570M410 250 470 370H570M570 150V370" pathLength="1" style="--d: 1100ms"></path>
        <circle class="draft__line draft__line--accent" cx="470" cy="150" r="14" pathLength="1" style="--d: 1500ms"></circle>
        <circle class="draft__line draft__line--accent" cx="470" cy="370" r="14" pathLength="1" style="--d: 1600ms"></circle>
        <circle class="draft__line" cx="570" cy="260" r="26" pathLength="1" style="--d: 1700ms"></circle>
      </svg>
      <svg class="draft draft--dims" viewBox="0 0 640 520" focusable="false" data-parallax="0.16">
        <g class="draft__dim" style="--d: 2300ms">
          <path d="M110 460H410M110 440V480M410 440V480"></path>
          <path class="draft__arrow" d="M110 460l12-5v10zM410 460l-12-5v10z"></path>
        </g>
        <g class="draft__dim" style="--d: 2500ms">
          <path d="M610 150V370M590 150H630M590 370H630"></path>
          <path class="draft__arrow" d="M610 150l-5 12h10zM610 370l-5-12h10z"></path>
        </g>
        <g class="draft__callout" style="--d: 2700ms">
          <path d="M366 144 420 70"></path>
          <circle cx="432" cy="56" r="17"></circle>
          <text x="432" y="62" text-anchor="middle">1</text>
        </g>
        <g class="draft__callout" style="--d: 2850ms">
          <path d="M484 382 520 452"></path>
          <circle cx="528" cy="468" r="17"></circle>
          <text x="528" y="474" text-anchor="middle">2</text>
        </g>
      </svg>
    </div>
  </div>
</section>
