---
import type { ImageMetadata } from 'astro';
import BaseLayout from '@autoservice/shared/layouts/BaseLayout.astro';
import SiteHeader from '@autoservice/shared/components/SiteHeader.astro';
import SiteFooter from '@autoservice/shared/components/SiteFooter.astro';
import SectionHead from '@autoservice/shared/components/SectionHead.astro';
import QuotePanel from '@autoservice/shared/components/QuotePanel.astro';
import ContactPanel from '@autoservice/shared/components/ContactPanel.astro';
import LeadForm from '@autoservice/shared/components/LeadForm.astro';
import Gallery from '@autoservice/shared/components/Gallery.astro';
import Icon from '@autoservice/shared/components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import Hero from '../components/Hero.astro';
import '../styles/theme.css';
import { ratingCountLabel } from '@autoservice/shared/lib/model';
import { site, nav, THEME_COLOR } from '../site';

// Approved first-party photos only (see shared/components/Gallery.astro).
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../../../../services/service_04/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const a = site.content.addressRu;
const [streetName, houseNumber] = a.street.split(', ');

const facts = [
  { label: 'Категория', value: site.content.categoryRu, hint: 'обслуживание и ремонт автомобилей' },
  { label: 'Город', value: a.city, hint: a.region },
  ...(site.rating
    ? [{ label: 'Рейтинг в 2ГИС', value: site.rating.value, hint: ratingCountLabel(site.rating) }]
    : []),
  {
    label: 'Канал связи',
    value: site.messengers.length > 0 ? site.messengers.join(', ') : '2ГИС',
    hint: 'указан в карточке компании',
  },
];

const shortcuts = [
  { href: '#prices', num: '02', title: 'Стоимость', note: 'по запросу' },
  { href: '#contacts', num: '03', title: 'Контакты', note: 'адрес и карточка в 2ГИС' },
  { href: '#request', num: '04', title: 'Заявка', note: 'форма на этой странице' },
];
---

<BaseLayout site={site} title="автосервис в Комсомольске-на-Амуре" themeColor={THEME_COLOR}>
  <link slot="head" rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <SiteHeader slot="header" site={site} nav={nav}>
    <BrandMark slot="mark" />
  </SiteHeader>

  <Hero />

  <section class="facts" aria-label="Коротко о сервисе">
    <div class="container">
      <dl class="facts__grid" data-stagger>
        {
          facts.map((fact, index) => (
            <div class="facts__cell" data-reveal="up">
              <span class="facts__num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <dt>{fact.label}</dt>
              <dd class="facts__value">{fact.value}</dd>
              <dd class="facts__hint">{fact.hint}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="container split" style="--split: 1.2fr 1fr">
      <div>
        <SectionHead id="about-title" index="01" eyebrow="О сервисе" title="Автосервис на Вокзальной" />
        <div class="about__text stack" style="--stack-gap: 1.25rem">
          <p data-reveal="up">
            {site.name} — автосервис в Центральном округе Комсомольска-на-Амуре. Профиль — обслуживание
            и ремонт автомобилей. Адрес: {a.street}.
          </p>
          <p class="muted" data-reveal="up">
            На этой странице собраны только проверенные сведения из карточки компании. Телефон,
            актуальный график и подробности — в карточке сервиса в 2ГИС.
          </p>
          <p data-reveal="up">
            <a class="text-link about__link" href={site.links.profile} target="_blank" rel="noopener noreferrer">
              Карточка сервиса в 2ГИС
              <Icon name="external" />
              <span class="sr-only">(откроется в новой вкладке)</span>
            </a>
          </p>
        </div>
      </div>
      <ol class="index-list" data-stagger aria-label="Разделы страницы">
        {
          shortcuts.map((item) => (
            <li data-reveal="left">
              <a class="index-list__link" href={item.href}>
                <span class="index-list__num" aria-hidden="true">
                  {item.num}
                </span>
                <span class="index-list__text">
                  <strong>{item.title}</strong>
                  <span>{item.note}</span>
                </span>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt cost" id="prices" aria-labelledby="prices-title">
    <div class="container split" style="--split: 1fr 1.25fr">
      <SectionHead
        id="prices-title"
        index="02"
        eyebrow="Стоимость"
        title="Цены — по запросу"
        lead="В доступных данных карточки нет подтверждённого прайс-листа, поэтому цены на сайте не указаны."
      />
      <QuotePanel
        title="Расчёт под вашу задачу"
        text="Опишите автомобиль и что нужно сделать — стоимость и сроки сообщит сам сервис."
      >
        <a class="btn" href={site.links.profile} target="_blank" rel="noopener noreferrer">
          Карточка в 2ГИС
          <Icon name="external" />
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>
      </QuotePanel>
    </div>
  </section>

  {
    site.photos.length > 0 && (
      <section class="section" id="gallery" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHead id="gallery-title" eyebrow="Фото" title="Фотографии сервиса" />
          <Gallery photos={site.photos} files={photoFiles} />
        </div>
      </section>
    )
  }

  <section class="section" id="contacts" aria-labelledby="contacts-title">
    <div class="container split" style="--split: 1fr 1.1fr">
      <div class="location" data-reveal="clip">
        <p class="location__eyebrow"><Icon name="pin" /> Как найти</p>
        <p class="location__number" aria-hidden="true" data-parallax="0.04">{houseNumber}</p>
        <div class="location__road" aria-hidden="true"></div>
        <div class="location__body">
          <p class="location__street">{streetName}, {houseNumber}</p>
          <p class="location__area">{a.district}, {a.city}</p>
          <a class="text-link" href={site.links.profile} target="_blank" rel="noopener noreferrer">
            Посмотреть на карте 2ГИС
            <Icon name="external" />
            <span class="sr-only">(откроется в новой вкладке)</span>
          </a>
        </div>
      </div>
      <div>
        <SectionHead id="contacts-title" index="03" eyebrow="Контакты" title="Адрес и связь" />
        <ContactPanel site={site} />
      </div>
    </div>
  </section>

  <section class="section section--alt request" id="request" aria-labelledby="request-title">
    <div class="container split" style="--split: 1fr 1.15fr">
      <div class="request__intro">
        <SectionHead
          id="request-title"
          index="04"
          eyebrow="Заявка"
          title="Опишите задачу"
          lead="Укажите автомобиль и что нужно сделать. Стоимость и время визита сообщит сервис."
        />
      </div>
      <div data-reveal="up">
        <LeadForm site={site} options={[]} />
      </div>
    </div>
  </section>

  <div class="end-band" aria-hidden="true"></div>

  <SiteFooter slot="footer" site={site} nav={nav} />
</BaseLayout>
