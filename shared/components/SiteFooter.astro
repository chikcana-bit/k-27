---
import type { SiteModel } from '../lib/types';
import { withBase } from '../lib/env';
import type { NavItem } from './SiteHeader.astro';
interface Props {
  site: SiteModel;
  nav: NavItem[];
  home?: boolean;
}
const { site, nav, home = true } = Astro.props;
const resolve = (href: string) => (href.startsWith('#') && !home ? withBase('/') + href : href);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="stack">
        <p class="site-footer__name">{site.name}</p>
        <p>{site.content.categoryRu}</p>
        <p>{site.addressLine}</p>
        {
          site.phones.map((phone) => (
            <p>
              <a href={`tel:${phone.href}`}>{phone.display}</a>
            </p>
          ))
        }
      </div>
      <nav aria-label="Навигация в подвале">
        <p class="site-footer__title">Разделы</p>
        <ul class="site-footer__links">
          {
            nav.map((item) => (
              <li>
                <a href={resolve(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div>
        <p class="site-footer__title">Информация</p>
        <ul class="site-footer__links">
          {
            site.website && (
              <li>
                <a href={site.website} target="_blank" rel="noopener noreferrer">
                  Сайт компании<span class="sr-only"> (откроется в новой вкладке)</span>
                </a>
              </li>
            )
          }
          <li>
            <a href={site.mapUrl} target="_blank" rel="noopener noreferrer">
              Адрес на карте<span class="sr-only"> (откроется в новой вкладке)</span>
            </a>
          </li>
          <li><a href={withBase('/privacy/')}>Политика конфиденциальности</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <p>
        Демонстрационный концепт сайта. Сведения о компании предоставлены владельцем данных и ожидают
        подтверждения; информация на сайте не является публичной офертой.
      </p>
    </div>
  </div>
</footer>
