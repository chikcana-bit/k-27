---
import type { ImageMetadata } from 'astro';
import BaseLayout from '@autoservice/shared/layouts/BaseLayout.astro';
import SiteHeader from '@autoservice/shared/components/SiteHeader.astro';
import SiteFooter from '@autoservice/shared/components/SiteFooter.astro';
import SectionHead from '@autoservice/shared/components/SectionHead.astro';
import PriceList from '@autoservice/shared/components/PriceList.astro';
import RatingBadge from '@autoservice/shared/components/RatingBadge.astro';
import ContactPanel from '@autoservice/shared/components/ContactPanel.astro';
import LeadForm from '@autoservice/shared/components/LeadForm.astro';
import Gallery from '@autoservice/shared/components/Gallery.astro';
import Icon from '@autoservice/shared/components/Icon.astro';
import { ratingCountLabel } from '@autoservice/shared/lib/model';
import BrandMark from '../components/BrandMark.astro';
import Hero from '../components/Hero.astro';
import '../styles/theme.css';
import { site, nav, THEME_COLOR } from '../site';

// Approved first-party photos only (see shared/components/Gallery.astro).
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../../../../services/service_05/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const a = site.content.addressRu;
const num = (index: number) => String(index + 1).padStart(2, '0');
---

<BaseLayout site={site} title="автомастерская в Комсомольске-на-Амуре" themeColor={THEME_COLOR}>
  <link slot="head" rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <SiteHeader slot="header" site={site} nav={nav}>
    <BrandMark slot="mark" />
  </SiteHeader>

  <Hero />

  <section class="titleblock" aria-label="Коротко о мастерской">
    <div class="container">
      <dl class="titleblock__grid" data-stagger>
        <div class="titleblock__cell titleblock__cell--name" data-reveal="up">
          <dt>Наименование</dt>
          <dd>{site.name}</dd>
        </div>
        <div class="titleblock__cell" data-reveal="up">
          <dt>Категория</dt>
          <dd>{site.content.categoryRu}</dd>
        </div>
        {
          site.hoursRu && (
            <div class="titleblock__cell titleblock__cell--accent" data-reveal="up">
              <dt>Режим работы</dt>
              <dd>{site.hoursRu}</dd>
            </div>
          )
        }
        <div class="titleblock__cell" data-reveal="up">
          <dt>Адрес</dt>
          <dd>{a.street}</dd>
        </div>
        {
          site.rating && (
            <div class="titleblock__cell" data-reveal="up">
              <dt>Рейтинг в 2ГИС</dt>
              <dd>
                {site.rating.value} · {ratingCountLabel(site.rating)}
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <SectionHead
        id="services-title"
        index="A"
        eyebrow="Услуги"
        title="Узлы и работы"
        lead="Направления, указанные в карточке мастерской."
      />
      <ol class="parts" data-stagger>
        {
          site.services.map((item, index) => (
            <li class="part" data-reveal="up" data-spotlight>
              <span class="part__num" aria-hidden="true">
                {num(index)}
              </span>
              <h3 class="part__title">{item}</h3>
              <span class="part__leader" aria-hidden="true" />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt spec" id="prices" aria-labelledby="prices-title">
    <div class="container">
      <SectionHead
        id="prices-title"
        index="B"
        eyebrow="Цены"
        title="Спецификация работ"
        lead="Начальные цены по основным позициям прайса."
      />
      <PriceList site={site} variant="leaders" />
    </div>
  </section>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="container split" style="--split: 1.3fr 1fr">
      <div>
        <SectionHead id="about-title" index="C" eyebrow="О мастерской" title={`${site.name} на Путейской`} />
        <p class="about__text" data-reveal="up">
          {site.name} — автомастерская в посёлке Молодёжном, Комсомольск-на-Амуре. Адрес: {a.street}. В
          карточке мастерской — ремонт и замена двигателя и трансмиссии, ремонт подвески и ходовой части,
          работы по карданному валу, ремонт и прокачка гидропневматической подвески и системы KDSS.
        </p>
      </div>
      <div class="stamp" data-reveal="left">
        <RatingBadge site={site} />
        <p class="muted">Мессенджер в карточке: {site.messengers.join(', ')}.</p>
      </div>
    </div>
  </section>

  {
    site.photos.length > 0 && (
      <section class="section section--alt" id="gallery" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHead id="gallery-title" eyebrow="Фото" title="Фотографии мастерской" />
          <Gallery photos={site.photos} files={photoFiles} />
        </div>
      </section>
    )
  }

  <section class="section section--alt" id="contacts" aria-labelledby="contacts-title">
    <div class="container split" style="--split: 1fr 1.1fr">
      <div class="plan" data-reveal="scale">
        <span class="plan__dim" aria-hidden="true"></span>
        <p class="eyebrow"><Icon name="pin" /> Как найти</p>
        <p class="plan__street">{a.street}</p>
        <p class="muted">{a.district}, {a.city}</p>
        <a class="text-link" href={site.links.profile} target="_blank" rel="noopener noreferrer">
          Посмотреть на карте 2ГИС
          <Icon name="external" />
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>
      </div>
      <div>
        <SectionHead id="contacts-title" index="D" eyebrow="Контакты" title="Адрес и связь" />
        <ContactPanel site={site} />
      </div>
    </div>
  </section>

  <section class="section request" id="request" aria-labelledby="request-title">
    <div class="container split" style="--split: 1fr 1.15fr">
      <div class="request__intro">
        <SectionHead
          id="request-title"
          index="E"
          eyebrow="Заявка"
          title="Опишите неисправность"
          lead="Укажите автомобиль и что нужно сделать. Стоимость и время визита сообщит мастерская."
        />
      </div>
      <div data-reveal="up">
        <LeadForm site={site} />
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" site={site} nav={nav} />
</BaseLayout>
