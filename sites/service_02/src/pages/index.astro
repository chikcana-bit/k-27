---
import type { ImageMetadata } from 'astro';
import BaseLayout from '@autoservice/shared/layouts/BaseLayout.astro';
import SiteHeader from '@autoservice/shared/components/SiteHeader.astro';
import SiteFooter from '@autoservice/shared/components/SiteFooter.astro';
import SectionHead from '@autoservice/shared/components/SectionHead.astro';
import PriceList from '@autoservice/shared/components/PriceList.astro';
import RatingBadge from '@autoservice/shared/components/RatingBadge.astro';
import ContactPanel from '@autoservice/shared/components/ContactPanel.astro';
import LeadForm from '@autoservice/shared/components/LeadForm.astro';
import Gallery from '@autoservice/shared/components/Gallery.astro';
import Icon from '@autoservice/shared/components/Icon.astro';
import { pluralRu } from '@autoservice/shared/lib/model';
import BrandMark from '../components/BrandMark.astro';
import Hero from '../components/Hero.astro';
import '../styles/theme.css';
import { site, nav, THEME_COLOR } from '../site';

// Approved first-party photos only (see shared/components/Gallery.astro).
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../../../../services/service_02/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const a = site.content.addressRu;
const step = 360 / site.services.length;
---

<BaseLayout site={site} title="детейлинг-студия в Комсомольске-на-Амуре" themeColor={THEME_COLOR}>
  <link slot="head" rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <SiteHeader slot="header" site={site} nav={nav}>
    <BrandMark slot="mark" />
  </SiteHeader>

  <Hero />

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <SectionHead
        id="services-title"
        index="0°"
        eyebrow="Услуги"
        title="Пять направлений студии"
        lead="Направления работ из карточки компании."
      />
      <ol class="orbit" data-stagger>
        {
          site.services.map((item, index) => (
            <li class="orbit__item" data-reveal="up">
              <span class="orbit__deg" aria-hidden="true" style={`--turn: ${Math.round(step * (index + 1))}deg`}>
                <i />
                <b>{Math.round(step * (index + 1))}°</b>
              </span>
              <h3 class="orbit__title">{item}</h3>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt" id="prices" aria-labelledby="prices-title">
    <div class="container split" style="--split: 0.8fr 1.6fr">
      <div class="prices__intro">
        <SectionHead
          id="prices-title"
          index="90°"
          eyebrow="Цены"
          title="Прайс по группам"
          lead="Откройте группу, чтобы увидеть позиции. Итог зависит от автомобиля — его назовёт студия."
        />
      </div>
      <div class="groups">
        {
          site.priceGroups.map((group, index) => (
            <details class="group" open={index === 0} data-reveal="up">
              <summary class="group__summary">
                <span class="group__title">{group.titleRu}</span>
                <span class="group__count">
                  {group.rows.length} {pluralRu(group.rows.length, ['позиция', 'позиции', 'позиций'])}
                </span>
                <span class="group__icon" aria-hidden="true" />
              </summary>
              <div class="group__body">
                <PriceList site={site} rows={group.rows} variant="plain" showNote={false} />
              </div>
            </details>
          ))
        }
        <div class="groups__note">
          <PriceList site={site} rows={[]} />
        </div>
      </div>
    </div>
  </section>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="container split" style="--split: 1.3fr 1fr">
      <div>
        <SectionHead id="about-title" index="180°" eyebrow="О студии" title={`Студия ${site.name} на Котовского`} />
        <p class="about__text" data-reveal="up">
          {site.name} — детейлинг-студия в Центральном округе Комсомольска-на-Амуре. Адрес: {a.street}. В
          карточке студии — оклейка антигравийной и виниловой плёнкой, плёнки на стёкла, полировка и уход за
          кузовом, шумоизоляция.
        </p>
      </div>
      <div class="capsule" data-reveal="left">
        <RatingBadge site={site} />
        <p class="muted">Мессенджеры в карточке: {site.messengers.join(', ')}.</p>
      </div>
    </div>
  </section>

  {
    site.photos.length > 0 && (
      <section class="section section--alt" id="gallery" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHead id="gallery-title" eyebrow="Фото" title="Фотографии студии" />
          <Gallery photos={site.photos} files={photoFiles} />
        </div>
      </section>
    )
  }

  <section class="section section--alt" id="contacts" aria-labelledby="contacts-title">
    <div class="container split" style="--split: 1fr 1.1fr">
      <div class="pin" data-reveal="scale">
        <span class="pin__rings" aria-hidden="true"></span>
        <p class="eyebrow"><Icon name="pin" /> Как найти</p>
        <p class="pin__street">{a.street}</p>
        <p class="muted">{a.district}, {a.city}</p>
        <a class="text-link" href={site.links.profile} target="_blank" rel="noopener noreferrer">
          Посмотреть на карте 2ГИС
          <Icon name="external" />
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>
      </div>
      <div>
        <SectionHead id="contacts-title" index="270°" eyebrow="Контакты" title="Адрес и связь" />
        <ContactPanel site={site} />
      </div>
    </div>
  </section>

  <section class="section request" id="request" aria-labelledby="request-title">
    <div class="container split" style="--split: 1fr 1.15fr">
      <div class="request__intro">
        <SectionHead
          id="request-title"
          index="360°"
          eyebrow="Заявка"
          title="Расскажите об автомобиле"
          lead="Укажите марку, модель и что нужно сделать. Стоимость и время визита сообщит студия."
        />
      </div>
      <div data-reveal="up">
        <LeadForm site={site} />
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" site={site} nav={nav} />
</BaseLayout>
