---
/** Signal home page: poster hero → facts strip → about → cost on request → contacts → request. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SectionHead from '../../components/SectionHead.astro';
import QuotePanel from '../../components/QuotePanel.astro';
import ServiceList from '../../components/ServiceList.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import LeadForm from '../../components/LeadForm.astro';
import Gallery from '../../components/Gallery.astro';
import Icon from '../../components/Icon.astro';
import { pluralRu } from '../../lib/model';
import Mark from './Mark.astro';
import Hero from './Hero.astro';
import './theme.css';
import type { TemplateProps } from '../types';

type Props = TemplateProps;
const { site, nav, themeColor, mirror, photoFiles = {} } = Astro.props;
const c = site.content;
const [, ...houseParts] = site.street.split(', ');
const houseNumber = houseParts[0] ?? '';
const phone = site.phones[0];
const count = site.services.length;

const facts = [
  { label: 'Профиль', value: c.categoryRu, hint: `${count} ${pluralRu(count, ['направление', 'направления', 'направлений'])} работ` },
  { label: 'Город', value: site.city, hint: site.region },
  { label: 'Адрес', value: site.street, hint: 'адрес и проезд — в разделе «Контакты»' },
  ...(phone ? [{ label: 'Телефон', value: phone.display, hint: 'запись и стоимость' }] : []),
];

const shortcuts = [
  { href: '#prices', num: '02', title: 'Стоимость', note: 'по телефону' },
  { href: '#contacts', num: '03', title: 'Контакты', note: 'адрес и телефон' },
  { href: '#request', num: '04', title: 'Заявка', note: 'форма на этой странице' },
];
---

<BaseLayout site={site} title={c.pageTitle} themeColor={themeColor}>
  <link slot="head" rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <SiteHeader slot="header" site={site} nav={nav}>
    <Mark slot="mark" />
  </SiteHeader>

  <Hero site={site} mirror={mirror} />

  <section class="facts" aria-label="Коротко о сервисе">
    <div class="container">
      <dl class="facts__grid" data-stagger>
        {
          facts.map((fact, index) => (
            <div class="facts__cell" data-reveal="up">
              <span class="facts__num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <dt>{fact.label}</dt>
              <dd class="facts__value">{fact.value}</dd>
              <dd class="facts__hint">{fact.hint}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="container split" style="--split: 1.2fr 1fr">
      <div>
        <SectionHead id="about-title" index="01" eyebrow="О сервисе" title={c.aboutTitle} />
        <div class="about__text stack" style="--stack-gap: 1.25rem">
          <p data-reveal="up">{c.aboutText}</p>
          <ServiceList items={site.services} variant="tags" />
        </div>
      </div>
      <ol class="index-list" data-stagger aria-label="Разделы страницы">
        {
          shortcuts.map((item) => (
            <li data-reveal="left">
              <a class="index-list__link" href={item.href}>
                <span class="index-list__num" aria-hidden="true">
                  {item.num}
                </span>
                <span class="index-list__text">
                  <strong>{item.title}</strong>
                  <span>{item.note}</span>
                </span>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt cost" id="prices" aria-labelledby="prices-title">
    <div class="container split" style="--split: 1fr 1.25fr">
      <SectionHead
        id="prices-title"
        index="02"
        eyebrow="Стоимость"
        title="Цены — по телефону"
        lead="Стоимость зависит от автомобиля и объёма работ. Мы не публикуем расценки, пока их не подтвердит сам сервис."
      />
      <QuotePanel
        title="Расчёт под вашу задачу"
        text="Опишите автомобиль и что нужно сделать — стоимость и сроки сообщит сервис."
      >
        {
          phone && (
            <a class="btn" href={`tel:${phone.href}`}>
              <Icon name="phone" />
              {phone.display}
            </a>
          )
        }
      </QuotePanel>
    </div>
  </section>

  {
    site.photos.length > 0 && (
      <section class="section" id="gallery" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHead id="gallery-title" eyebrow="Фото" title="Фотографии сервиса" />
          <Gallery photos={site.photos} files={photoFiles} />
        </div>
      </section>
    )
  }

  <section class="section" id="contacts" aria-labelledby="contacts-title">
    <div class="container split" style="--split: 1fr 1.1fr">
      <div class="location" data-reveal="clip">
        <p class="location__eyebrow"><Icon name="pin" /> Как найти</p>
        <p class="location__number" aria-hidden="true" data-parallax="0.04">{houseNumber}</p>
        <div class="location__road" aria-hidden="true"></div>
        <div class="location__body">
          <p class="location__street">{site.street}</p>
          <p class="location__area">{site.city}, {site.region}</p>
          <a class="text-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">
            Открыть на карте
            <Icon name="external" />
            <span class="sr-only">(откроется в новой вкладке)</span>
          </a>
        </div>
      </div>
      <div>
        <SectionHead id="contacts-title" index="03" eyebrow="Контакты" title="Адрес и связь" />
        <ContactPanel site={site} />
      </div>
    </div>
  </section>

  <section class="section section--alt request" id="request" aria-labelledby="request-title">
    <div class="container split" style="--split: 1fr 1.15fr">
      <div class="request__intro">
        <SectionHead id="request-title" index="04" eyebrow="Заявка" title={c.requestTitle} lead={c.requestLead} />
      </div>
      <div data-reveal="up">
        <LeadForm site={site} />
      </div>
    </div>
  </section>

  <div class="end-band" aria-hidden="true"></div>

  <SiteFooter slot="footer" site={site} nav={nav} />
</BaseLayout>
