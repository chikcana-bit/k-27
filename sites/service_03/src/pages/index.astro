---
import type { ImageMetadata } from 'astro';
import BaseLayout from '@autoservice/shared/layouts/BaseLayout.astro';
import SiteHeader from '@autoservice/shared/components/SiteHeader.astro';
import SiteFooter from '@autoservice/shared/components/SiteFooter.astro';
import SectionHead from '@autoservice/shared/components/SectionHead.astro';
import PriceList from '@autoservice/shared/components/PriceList.astro';
import RatingBadge from '@autoservice/shared/components/RatingBadge.astro';
import ContactPanel from '@autoservice/shared/components/ContactPanel.astro';
import LeadForm from '@autoservice/shared/components/LeadForm.astro';
import Gallery from '@autoservice/shared/components/Gallery.astro';
import Icon from '@autoservice/shared/components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import Hero from '../components/Hero.astro';
import '../styles/theme.css';
import { site, nav, THEME_COLOR } from '../site';

// Approved first-party photos only (see shared/components/Gallery.astro).
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../../../../services/service_03/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const a = site.content.addressRu;
const num = (index: number) => String(index + 1).padStart(2, '0');
---

<BaseLayout site={site} title="перетяжка салона и детейлинг в Комсомольске-на-Амуре" themeColor={THEME_COLOR}>
  <link slot="head" rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <SiteHeader slot="header" site={site} nav={nav}>
    <BrandMark slot="mark" />
  </SiteHeader>

  <Hero />

  <section class="section statement" id="about" aria-labelledby="about-title">
    <div class="container statement__grid">
      <p class="eyebrow statement__eyebrow" data-reveal="fade"><span class="section-head__index">I</span> Ателье</p>
      <div class="statement__body">
        <h2 id="about-title" class="statement__title" data-split>
          Салон, кузов и плёнки — по одному адресу
        </h2>
        <p class="statement__text" data-reveal="up">
          {site.name} работает в Центральном округе Комсомольска-на-Амуре, на {a.street}. В карточке
          ателье — перетяжка салона и его элементов, ремонт сидений, полировка и керамическое покрытие
          кузова, тонировка, химчистка, шумоизоляция и оклейка антигравийной плёнкой.
        </p>
      </div>
      <aside class="statement__aside" data-reveal="left">
        <RatingBadge site={site} />
        <p class="muted">Мессенджеры в карточке: {site.messengers.join(', ')}.</p>
      </aside>
    </div>
  </section>

  <section class="section section--alt" id="services" aria-labelledby="services-title">
    <div class="container">
      <SectionHead
        id="services-title"
        index="II"
        eyebrow="Услуги"
        title="Чем занимается ателье"
        lead="Направления работ, перечисленные в карточке компании."
      />
      <ol class="index" data-stagger>
        {
          site.services.map((item, index) => (
            <li class="index__item" data-reveal="up">
              <span class="index__num" aria-hidden="true">
                {num(index)}
              </span>
              <h3 class="index__title">{item}</h3>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section ledger" id="prices" aria-labelledby="prices-title">
    <div class="container split" style="--split: 0.8fr 1.6fr">
      <div class="ledger__intro">
        <SectionHead
          id="prices-title"
          index="III"
          eyebrow="Цены"
          title="Прайс-лист"
          lead="Начальные цены по позициям. Итог зависит от автомобиля и материалов — его назовёт ателье."
        />
        <a class="btn" href="#request" data-reveal="up">
          Запросить расчёт
          <Icon name="arrow" />
        </a>
      </div>
      <div>
        <PriceList site={site} variant="leaders" />
      </div>
    </div>
  </section>

  {
    site.photos.length > 0 && (
      <section class="section section--alt" id="gallery" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHead id="gallery-title" eyebrow="Фото" title="Работы ателье" />
          <Gallery photos={site.photos} files={photoFiles} />
        </div>
      </section>
    )
  }

  <section class="section section--alt" id="contacts" aria-labelledby="contacts-title">
    <div class="container split" style="--split: 1.1fr 1fr">
      <div>
        <SectionHead id="contacts-title" index="IV" eyebrow="Контакты" title="Адрес и связь" />
        <ContactPanel site={site} />
      </div>
      <div class="tag" data-reveal="scale">
        <span class="tag__hole" aria-hidden="true"></span>
        <p class="eyebrow"><Icon name="pin" /> Как найти</p>
        <p class="tag__street">{a.street}</p>
        <p class="muted">{a.district}, {a.city}</p>
        <a class="text-link" href={site.links.profile} target="_blank" rel="noopener noreferrer">
          Посмотреть на карте 2ГИС
          <Icon name="external" />
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section request" id="request" aria-labelledby="request-title">
    <div class="container split" style="--split: 1fr 1.15fr">
      <div class="request__intro">
        <SectionHead
          id="request-title"
          index="V"
          eyebrow="Заявка"
          title="Расскажите о задаче"
          lead="Укажите автомобиль и что нужно сделать: перетянуть, отполировать, оклеить. Стоимость сообщит ателье."
        />
      </div>
      <div data-reveal="up">
        <LeadForm site={site} />
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" site={site} nav={nav} />
</BaseLayout>
