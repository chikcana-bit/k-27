---
/** Graphic mark: a stitched patch crossed by a needle. Decorative, not an official logo. */
---

<svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="3" y="3" width="26" height="26" rx="3" fill="currentColor"></rect>
  <rect
    x="7"
    y="7"
    width="18"
    height="18"
    rx="1.5"
    fill="none"
    stroke="var(--c-bg)"
    stroke-width="1.4"
    stroke-dasharray="3 2.2"
    stroke-linecap="round"></rect>
  <path d="M11.5 20.5 20.5 11.5" stroke="var(--c-bg)" stroke-width="1.8" stroke-linecap="round"></path>
</svg>
